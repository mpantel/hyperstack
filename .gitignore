/.idea/
*.gem
/ruby/**/*.gem
/ruby/**/*.lock
/ruby/**/node_modules/
/**/.byebug_history
/node_modules/node_modules
/local_gems/
.DS_Store
/yarn.lock
/node_modules/
/ruby/rails-hyperstack/spec/test_app/
# generated test_app build artifacts
/ruby/**/spec/test_app/public/assets/
/ruby/**/spec/test_app/app/assets/builds/
/ruby/**/spec/test_app/db/schema.rb
# yarn download cache, kept in-project so GitLab CI can cache it (#55)
/.yarn-cache/
# esbuild scaffolding written into a gem's spec/test_app at `rake spec:prepare`
# when the cell selects HYPERSTACK_REACT_SOURCE=npm (#40). The single tracked
# copy lives in ruby/test_app_esbuild; these are placed copies, not sources.
/ruby/**/spec/test_app/app/javascript/
/ruby/**/spec/test_app/esbuild.config.js
# npm-path backup of the files the esbuild wiring rewrites in place (#40); the
# gem path restores from it, so the React source stays a per-run choice locally.
/ruby/**/spec/test_app/.react_source_backup/
