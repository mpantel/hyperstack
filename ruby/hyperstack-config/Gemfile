source 'https://rubygems.org'
gem 'hyper-spec', path: '../hyper-spec'
# gem 'opal-browser', git: 'https://github.com/opal/opal-browser'
gemspec

# Ruby 3.4 dropped several gems from the default set (now "bundled gems"), but
# Rails 6.1.7.x (activesupport) still requires them. Declare them explicitly so
# the bundle resolves on Ruby >= 3.4. See #11 (3.3 -> 3.4 bump).
gem 'bigdecimal'
gem 'mutex_m'
gem 'drb'
gem 'base64'
gem 'logger'

# opal-rails pulls sprockets-rails in; the opal-sprockets route (the only one
# Rails 8 can take -- see supported_versions.yml) does not, and Rails 7+ no
# longer ships it with the framework. The test_app serves the Opal bundle
# through sprockets, so declare it. (#20)
gem 'sprockets-rails'
# Held on sprockets 4.x, but NOT capped below 4.2. The cap this Gemfile gained in
# #16 -- ">= 4.2 raises 'can't modify immutable cached environment' and stops
# compiling the Opal assets, which reaches the browser as 'Opal is not defined'"
# -- did not survive checking: 4.1.1 and 4.2.2 have identical caching machinery.
# The rails-7, rails-8.0 and rails-8.1 lines have all run uncapped since #17, and
# the Opal bundle compiles under 4.4.1 on every cell. (#123)
gem 'sprockets', '~> 4.0'
