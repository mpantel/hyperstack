source 'https://rubygems.org'
gem 'hyper-spec', path: '../hyper-spec'
# gem 'opal-browser', git: 'https://github.com/opal/opal-browser'
gemspec

# Ruby 3.4 dropped several gems from the default set (now "bundled gems"), but
# Rails 6.1.7.x (activesupport) still requires them. Declare them explicitly so
# the bundle resolves on Ruby >= 3.4. See #11 (3.3 -> 3.4 bump).
gem 'bigdecimal'
gem 'mutex_m'
gem 'drb'
gem 'base64'
gem 'logger'

# opal-rails pulls sprockets-rails in; the opal-sprockets route (the only one
# Rails 8 can take -- see supported_versions.yml) does not, and Rails 7+ no
# longer ships it with the framework. The test_app serves the Opal bundle
# through sprockets, so declare it. (#20)
gem 'sprockets-rails'
