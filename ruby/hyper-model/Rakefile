require "bundler/gem_tasks"
require "rspec/core/rake_task"

def run_batches(batches)
  failed = false
  batches.each do |batch|
    begin
      Rake::Task["spec:batch#{batch}"].invoke
    rescue SystemExit
      failed = true
    end
  end
  exit 1 if failed
end


# Specs run in PARALLEL by default: `rake spec` runs each batch intact across a
# pool of PARALLEL_PROCESSES databases (see spec:parallel). Set PARALLEL_SPECS=0
# to force the serial path (all batches in one process) -- handy for debugging.
def parallel_specs?
  ENV.fetch('PARALLEL_SPECS', '1') !~ /\A(0|false|no|off)\z/i
end

# part1..part7 run a single batch each (ad-hoc / per-batch use).
(1..7).each do |n|
  task :"part#{n}" do
    run_batches(n..n)
  end
end

task :spec do
  if parallel_specs?
    Rake::Task['spec:parallel'].invoke
  else
    run_batches(1..7)
  end
end

require_relative '../test_app_react_source'

namespace :spec do
  task :prepare do
    # #40: wire this test_app to npm/esbuild React when the cell asks for it
    # (HYPERSTACK_REACT_SOURCE=npm). A no-op on the default react-rails/sprockets
    # path, so the rails61-react16/17/18 cells are untouched. Runs FIRST: the
    # assets:precompile below link_trees app/assets/builds, which does not exist
    # until esbuild has written it.
    if TestAppReactSource.apply!(File.expand_path('spec/test_app', __dir__))
      puts "spec/test_app wired to npm React #{TestAppReactSource.npm_version}"
    end
    sh %(cd spec/test_app; rm db/schema.rb; RAILS_ENV=test bundle exec rails db:setup; RAILS_ENV=test bundle exec rails db:migrate)
    # When PRECOMPILED_ASSETS is set (CI browser jobs), build the static Opal
    # bundle once here so the specs run with compile=false (no debug-mode runtime
    # compilation -> a single concatenated application.js instead of hundreds of
    # per-file Sprockets requests per page boot). Opt-in so local runs are
    # unaffected. See environments/test.rb / initializers/assets.rb.
    sh %(cd spec/test_app; RAILS_ENV=test bundle exec rails assets:precompile) if ENV['PRECOMPILED_ASSETS']
  end
  (1..7).each do |batch|
    RSpec::Core::RakeTask.new(:"batch#{batch}") do |t|
      t.pattern = "spec/batch#{batch}/**/*_spec.rb"
    end
  end

  # Run all batches inside ONE job, across a pool of N OS processes. Each process
  # gets a TEST_ENV_NUMBER ('' , '2', '3', ...) which database.yml appends to the
  # DB name, so every process has its own PostgreSQL DB and they never collide.
  PARALLEL_PROCESSES = Integer(ENV['PARALLEL_PROCESSES'] || 4)

  desc 'Create one test database per parallel process'
  task :parallel_prepare do
    PARALLEL_PROCESSES.times do |i|
      env_number = i.zero? ? '' : (i + 1).to_s
      sh %(cd spec/test_app; rm -f db/schema.rb; ) +
         %(TEST_ENV_NUMBER='#{env_number}' RAILS_ENV=test bundle exec rails db:create db:migrate)
    end
  end

  desc 'Run each batch intact across a pool of N databases'
  task parallel: :parallel_prepare do
    # Precompile the (static) Opal bundle ONCE; workers run with
    # PRECOMPILED_ASSETS=1 / compile=false (no runtime compilation, no FileStore
    # race -- and ~5x faster per example than debug-mode runtime compilation).
    # Skip if a CI before_script (spec:prepare) already built it.
    unless Dir.glob('spec/test_app/public/assets/.sprockets-manifest-*.json').any?
      sh %(cd spec/test_app; PRECOMPILED_ASSETS=1 RAILS_ENV=test bundle exec rails assets:precompile)
    end

    # Parallelize at the BATCH level, never splitting a batch across workers.
    # The model suite has pervasive global ActiveRecord class state (default
    # scopes, default values, validations); file-level distribution reshuffles
    # specs and breaks the per-batch ordering that keeps them green. Each batch
    # already passes serially (that's the current 7-job CI), so we run each batch
    # intact in one process and only parallelize *across* batches. A pool of
    # PARALLEL_PROCESSES databases (TEST_ENV_NUMBER) is shared by the 7 batches:
    # a batch grabs a free DB slot, runs, then releases it for the next batch.
    require 'thread'
    slots = Queue.new
    PARALLEL_PROCESSES.times { |i| slots << (i.zero? ? '' : (i + 1).to_s) }
    failed = false
    mutex = Mutex.new
    (1..7).map do |batch|
      Thread.new do
        slot = slots.pop
        begin
          ok = system(
            { 'TEST_ENV_NUMBER' => slot, 'PRECOMPILED_ASSETS' => '1' },
            "bundle exec rspec spec/batch#{batch}"
          )
          mutex.synchronize { failed ||= !ok }
        rescue => e
          warn "batch#{batch} failed to run: #{e.message}"
          mutex.synchronize { failed = true }
        ensure
          slots << slot
        end
      end
    end.each(&:join)
    # Any failed batch (non-zero rspec exit, crash, or worker exception) fails
    # the whole job -- parallel runs must error on failures, never pass silently.
    exit(1) if failed
  end
end

task :default => :spec
