require "bundler/gem_tasks"
require "rspec/core/rake_task"
require 'pry'

RSpec::Core::RakeTask.new(:spec)

# Which JavaScript pipeline the generated test app should use. Mirrors the
# generator's own choice (see generators/hyperstack/install_generator_base.rb
# #js_pipeline_name) so the harness and the generator can never disagree:
# Webpacker for Rails < 7, esbuild + jsbundling for Rails >= 7, and
# HYPERSTACK_JS_PIPELINE overrides both. (#51)
def hyperstack_js_pipeline
  ENV['HYPERSTACK_JS_PIPELINE'] || (hyperstack_rails_major >= 7 ? 'esbuild' : 'webpacker')
end

def hyperstack_rails_major
  # the cell exports RAILS_VERSION (e.g. "~> 7.2"); fall back to the bundled gem
  if (v = ENV['RAILS_VERSION'].to_s[/\d+/])
    v.to_i
  else
    Gem::Specification.find_by_name('rails').version.segments.first
  end
rescue StandardError
  6
end

namespace :spec do
  task :prepare do
    rails_version = `bundle info rails`.match(/\* rails \((.+)\)/)[1]
    opal_version = `bundle info opal`.match(/\* opal \((.+)\)/)[1]
    Dir.chdir('spec') do
      sh('rm -rf test_app')
      Bundler.with_unbundled_env do
        # sh("rails _#{rails_version}_ new test_app -T")
        sh("gem install zeitwerk -v 2.6.18") if rails_version < '7'
        sh("gem install nokogiri -v 1.15.6") if rails_version < '7'
        sh("gem install net-imap -v 0.4.18") if rails_version < '7'
        sh("gem install concurrent-ruby -v 1.3.4") if rails_version < '7'
        sh("gem install foreman")
        sh("gem install rails --version=#{rails_version}")
        sh("gem uninstall net-imap --version '> 0.4.18'") if rails_version < '7'
        sh("gem uninstall concurrent-ruby --version '> 1.3.4'") if rails_version < '7'
        # --skip-javascript on Rails 7+: do not scaffold importmap/jsbundling,
        # which creates its own app/javascript entry point. Hyperstack serves JS
        # via sprockets, and the esbuild strategy writes its own
        # app/javascript/react_runtime.js -- without the skip the two collide as
        #   Sprockets::DoubleLinkError: Multiple files with the same output path
        #   cannot be linked ("react_runtime.js")
        # Not passed on Rails < 7, where there is no such scaffolding and the
        # Webpacker path expects the default layout. (#51)
        skip_js = hyperstack_js_pipeline == 'webpacker' ? '' : ' --skip-javascript'
        sh("rails _#{rails_version}_ new test_app -T#{skip_js}")
      end
      Bundler.with_unbundled_env do
        Dir.chdir('test_app') do
          sh('cat ../gems.rb >> Gemfile')
          sh("echo 'gem \"opal\", \"#{opal_version}\"' >> Gemfile")
          sh("echo 'gem \"net-imap\", \"0.4.18\"' >> Gemfile")
          sh("echo 'gem \"concurrent-ruby\", \"1.3.4\"' >> Gemfile") # if rails_version < '7'
          # react-rails (< 2.7) is incompatible with connection_pool >= 3.0
          sh("echo 'gem \"connection_pool\", \"< 3.0\"' >> Gemfile")
          # Ruby 3.4 demotes these from default gems to bundled gems, but Rails
          # 6.1.7.x (activesupport) still requires them at boot. Under `bundle
          # exec` bundler drops default gems not in the Gemfile from the load
          # path, so without these the app fails with "cannot load such file --
          # bigdecimal". Declare them explicitly. See #11 (3.3 -> 3.4 bump).
          sh("echo 'gem \"bigdecimal\"' >> Gemfile")
          sh("echo 'gem \"mutex_m\"' >> Gemfile")
          sh("echo 'gem \"drb\"' >> Gemfile")
          sh("echo 'gem \"base64\"' >> Gemfile")
          sh("echo 'gem \"logger\"' >> Gemfile")
          # Rails 6.1 + Ruby 3.x: active_support/logger references ::Logger before
          # it is required -> "uninitialized constant LoggerThreadSafeLevel::Logger".
          # On Ruby 3.4 logger is a bundled gem and the command path (bin/rails ->
          # rails/commands) loads activesupport *before* config/application.rb, so
          # the require must go in config/boot.rb, which loads first (before
          # bundler/setup), guaranteeing Logger is defined early enough.
          sh(%q{ruby -e 'f="config/boot.rb"; File.write(f, %Q(require "logger"\n)+File.read(f))'})
          sh("bundle update")
          sh("bundle binstubs bundler")
          if hyperstack_js_pipeline == 'webpacker'
            sh("bundle exec rails webpacker:install")
            sh('spring stop')
          else
            # esbuild + jsbundling (#19/#21): the generator runs yarn install +
            # yarn build itself, so there is nothing to install here. Rails 7's
            # default app no longer bundles spring, so `spring stop` exits 127 --
            # make it non-fatal rather than aborting the whole task.
            sh('spring stop || true')
          end
          sh('bundle exec rails g hyperstack:install')
          sh('bundle exec rails generate model Sample name:string description:text')
          sleep 1
          sh('pwd')
          sh('ls app/models')
          sh('mv app/models/sample.rb app/hyperstack/models/sample.rb')
          sh("cat ../server_side_sample.rb >> app/models/sample.rb")
          sh('bundle exec rake db:migrate')
          sh('RAILS_ENV=test bundle exec rake db:setup')
          # sh('bundle exec rails dev:cache') # not tested yet...
          if hyperstack_js_pipeline == 'webpacker'
            sh('RAILS_ENV=test bundle exec rails webpacker:compile')
          else
            # sprockets-only: precompile the Opal/sprockets assets (the React
            # bundles were already built by esbuild during the generator run).
            sh('RAILS_ENV=test bundle exec rails assets:precompile')
          end
        end
      end
    end
  end
end

task :default => :spec
