require "bundler/gem_tasks"
require "rspec/core/rake_task"
require 'pry'
require_relative 'spec_prepare_gems'

RSpec::Core::RakeTask.new(:spec)

# Which JavaScript pipeline the generated test app should use. Mirrors the
# generator's own choice (see generators/hyperstack/install_generator_base.rb
# #js_pipeline_name) so the harness and the generator can never disagree:
# Webpacker for Rails < 7, esbuild + jsbundling for Rails >= 7, and
# HYPERSTACK_JS_PIPELINE overrides both. (#51)
#
# The decision itself lives in spec_prepare_gems.rb, because the cell image build
# has to make the same one when it scaffolds its warm-up app (#75).
def hyperstack_js_pipeline
  SpecPrepareGems.js_pipeline(hyperstack_rails_major)
end

# Put the gems `spec:prepare` needs into GEM_HOME -- skipping every one that is
# already there. On a cell image they are ALL already there (#73): the image
# build ran this same list (docker/cell-image/Dockerfile), so each call becomes a
# no-op and the ~200s nokogiri source build disappears from every rails61 job.
#
# HYPERSTACK_PREBAKED_SPEC_GEMS is the image declaring that it carries them. If
# it says so and one is missing, stop: #57's rule for the prebaked bundle applies
# here too -- a broken or stale image has to fail loudly, not masquerade as a
# slow success while it silently recompiles nokogiri for three minutes.
def install_spec_prepare_gems(rails_version)
  missing = SpecPrepareGems.missing(rails_version)

  if !ENV['HYPERSTACK_PREBAKED_SPEC_GEMS'].to_s.empty? && missing.any?
    abort "image declares HYPERSTACK_PREBAKED_SPEC_GEMS but does not carry " \
          "#{missing.map { |n, v| [n, v].compact.join(' ') }.join(', ')} -- " \
          'rebuild the cell image (docker/cell-image/build.sh) rather than ' \
          'installing these per job'
  end

  return if missing.empty?

  missing.each { |name, version| sh(SpecPrepareGems.install_command(name, version)) }
  # Only after an install: the surplus copies exist only because `gem install
  # rails` just dragged them in, so on a prebaked image there is nothing to
  # clean up and running these would just print "not installed" twice.
  SpecPrepareGems.surplus(rails_version).each { |name, req| sh(SpecPrepareGems.uninstall_command(name, req)) }
end

def hyperstack_rails_major
  # the cell exports RAILS_VERSION (e.g. "~> 7.2"); fall back to the bundled gem
  if (v = ENV['RAILS_VERSION'].to_s[/\d+/])
    v.to_i
  else
    Gem::Specification.find_by_name('rails').version.segments.first
  end
rescue StandardError
  6
end

namespace :spec do
  task :prepare do
    rails_version = `bundle info rails`.match(/\* rails \((.+)\)/)[1]
    opal_version = `bundle info opal`.match(/\* opal \((.+)\)/)[1]
    Dir.chdir('spec') do
      sh('rm -rf test_app')
      Bundler.with_unbundled_env do
        # sh("rails _#{rails_version}_ new test_app -T")
        # The pinned list lives in spec_prepare_gems.rb, because the cell image
        # bakes exactly these in and neither copy may drift from the other (#73).
        install_spec_prepare_gems(rails_version)
        # --skip-javascript on Rails 7+: do not scaffold importmap/jsbundling,
        # which creates its own app/javascript entry point. Hyperstack serves JS
        # via sprockets, and the esbuild strategy writes its own
        # app/javascript/react_runtime.js -- without the skip the two collide as
        #   Sprockets::DoubleLinkError: Multiple files with the same output path
        #   cannot be linked ("react_runtime.js")
        # Not passed on Rails < 7, where there is no such scaffolding and the
        # Webpacker path expects the default layout. (#51)
        skip_js = hyperstack_js_pipeline == 'webpacker' ? '' : ' --skip-javascript'
        # --skip-asset-pipeline on Rails 8: `rails new` defaults to Propshaft
        # there, and `--asset-pipeline=sprockets` is a no-op (it still writes
        # `gem "propshaft"` and no manifest.js). react-rails' railtie calls
        # `Rails.application.assets.version`, which Propshaft::Assembly does not
        # implement, so the app dies at boot with `undefined method 'version' for
        # an instance of Propshaft::Assembly`. Hyperstack serves the Opal bundle
        # through sprockets, so add no asset gem here and declare sprockets-rails
        # explicitly below. Not passed on Rails < 8, where sprockets IS the
        # default and the four older cells depend on it. (#20)
        skip_assets = hyperstack_rails_major >= 8 ? ' --skip-asset-pipeline' : ''
        # Ruby 3.4 + Rails 6.1: activesupport's LoggerThreadSafeLevel reads
        # ::Logger at load time without requiring it, so whether `rails new`
        # boots at all depends on what is in GEM_HOME. It used to get away with
        # it because `logger` was only ever the stdlib copy; now that the cell
        # image's warm-up app declares it (#75) there is a `logger` GEM there
        # too, rubygems defers it, and the generator dies with
        #   uninitialized constant ActiveSupport::LoggerThreadSafeLevel::Logger
        # This is the same fix config/boot.rb gets below, applied to the
        # generator command itself -- which runs before that file exists.
        # Verified against a warmed image: exit 1 without, exit 0 with.
        rubyopt = "-rlogger #{ENV['RUBYOPT']}".strip
        sh({ 'RUBYOPT' => rubyopt }, "rails _#{rails_version}_ new test_app -T#{skip_js}#{skip_assets}")
      end
      Bundler.with_unbundled_env do
        Dir.chdir('test_app') do
          sh('cat ../gems.rb >> Gemfile')
          if hyperstack_rails_major >= 8
            # --skip-asset-pipeline above added no asset gem, so ask for
            # sprockets by name... pinned below 4.2, which raises "can't modify
            # immutable cached environment" and stops compiling the Opal assets --
            # the browser then just reports "Opal is not defined". Every
            # component's own Gemfile carries this pin; the generated app was
            # resolving sprockets unbounded. (#16, #20)
            sh("echo 'gem \"sprockets-rails\"' >> Gemfile")
            sh("echo 'gem \"sprockets\", \"~> 4.0\", \"< 4.2\"' >> Gemfile")
            # ...and write the manifest it insists on. sprockets-rails raises
            # "Expected to find a manifest file in app/assets/config/manifest.js"
            # at BOOT, which happens well before `rails g hyperstack:install`
            # could create one. (#20)
            sh('mkdir -p app/assets/config app/assets/javascripts')
            sh(%q{printf '//= link_directory ../javascripts .js\n//= link_directory ../stylesheets .css\n//= link_tree ../images\n' > app/assets/config/manifest.js})
            # Hyperstack's data-sync transport is action_cable, and Rails 8
            # rejects cross-origin websocket connections by default. On CI the
            # browser's Origin differs from the Capybara server host, so /cable is
            # refused: the create broadcast never reaches the client and
            # `Sample.count` stays stale -- a failure that does NOT reproduce in a
            # `--network host` run locally. Allow it in the generated app's test
            # env only; the install generator must not weaken real apps. (#20)
            sh(%q{ruby -e 'f="config/environments/test.rb"; s=File.read(f); s=s.sub(/\nend\s*\z/, "\n  config.action_cable.disable_request_forgery_protection = true\nend\n") unless s.include?("disable_request_forgery_protection"); File.write(f, s)'})
          end
          sh("echo 'gem \"opal\", \"#{opal_version}\"' >> Gemfile")
          if hyperstack_rails_major < 8
            # Both are Rails 6.1/Ruby 3.4-era pins (see the Logger note below).
            # Rails 8 needs neither, and an exact net-imap 0.4.18 there is just an
            # old gem held down for no reason. (#20)
            sh("echo 'gem \"net-imap\", \"0.4.18\"' >> Gemfile")
            sh("echo 'gem \"concurrent-ruby\", \"1.3.4\"' >> Gemfile") # if rails_version < '7'
          end
          # react-rails (< 2.7) is incompatible with connection_pool >= 3.0
          sh("echo 'gem \"connection_pool\", \"< 3.0\"' >> Gemfile")
          # Ruby 3.4 demotes these from default gems to bundled gems, but Rails
          # 6.1.7.x (activesupport) still requires them at boot. Under `bundle
          # exec` bundler drops default gems not in the Gemfile from the load
          # path, so without these the app fails with "cannot load such file --
          # bigdecimal". Declare them explicitly. See #11 (3.3 -> 3.4 bump).
          #
          # The list is in spec_prepare_gems.rb: the image's warm-up app needs
          # the same declarations to boot, and two copies would drift (#75).
          SpecPrepareGems.app_bundled_gems.each do |gem_name|
            sh("echo 'gem \"#{gem_name}\"' >> Gemfile")
          end
          # Rails 6.1 + Ruby 3.x: active_support/logger references ::Logger before
          # it is required -> "uninitialized constant LoggerThreadSafeLevel::Logger".
          # On Ruby 3.4 logger is a bundled gem and the command path (bin/rails ->
          # rails/commands) loads activesupport *before* config/application.rb, so
          # the require must go in config/boot.rb, which loads first (before
          # bundler/setup), guaranteeing Logger is defined early enough.
          sh(%q{ruby -e 'f="config/boot.rb"; File.write(f, %Q(require "logger"\n)+File.read(f))'})
          sh("bundle update")
          sh("bundle binstubs bundler")
          if hyperstack_js_pipeline == 'webpacker'
            sh("bundle exec rails webpacker:install")
            sh('spring stop')
          else
            # esbuild + jsbundling (#19/#21): the generator runs yarn install +
            # yarn build itself, so there is nothing to install here. Rails 7's
            # default app no longer bundles spring, so `spring stop` exits 127 --
            # make it non-fatal rather than aborting the whole task.
            sh('spring stop || true')
          end
          sh('bundle exec rails g hyperstack:install')
          sh('bundle exec rails generate model Sample name:string description:text')
          sleep 1
          sh('pwd')
          sh('ls app/models')
          sh('mv app/models/sample.rb app/hyperstack/models/sample.rb')
          sh("cat ../server_side_sample.rb >> app/models/sample.rb")
          sh('bundle exec rake db:migrate')
          sh('RAILS_ENV=test bundle exec rake db:setup')
          # sh('bundle exec rails dev:cache') # not tested yet...
          if hyperstack_js_pipeline == 'webpacker'
            sh('RAILS_ENV=test bundle exec rails webpacker:compile')
          else
            # sprockets-only: precompile the Opal/sprockets assets (the React
            # bundles were already built by esbuild during the generator run).
            sh('RAILS_ENV=test bundle exec rails assets:precompile')
          end
        end
      end
    end
  end
end

task :default => :spec
