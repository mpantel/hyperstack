source 'https://rubygems.org'
gem 'hyperstack-config', path: '../hyperstack-config'
gem 'hyper-state',       path: '../hyper-state'
gem 'hyper-component',   path: '../hyper-component'
gem 'hyper-operation',   path: '../hyper-operation'
gem 'hyper-model',       path: '../hyper-model'
gem 'hyper-router',      path: '../hyper-router'
gem 'hyper-spec',        path: '../hyper-spec'
gem 'webpacker'  # TODO: figure out why these two are necessary!
gem 'turbolinks'
gem "selenium-webdriver" #, '3.142.7'

# CI/test harness: pin transitive deps to versions compatible with the
# react-rails this cell selected. sprockets >= 4.2 raises "can't modify immutable
# cached environment".
gem 'sprockets', '~> 4.0', '< 4.2'
# connection_pool 3.0 made ConnectionPool#initialize keyword-only, which the
# react-rails 2.x server-renderer pool calls positionally; 3.3 does not. So this
# belongs to the 2.x cells only -- see Hyperstack.connection_pool_selector. (#122)
require_relative '../version_selector'
gem 'connection_pool', *Hyperstack.connection_pool_selector
gemspec

# Ruby 3.4 dropped several gems from the default set (now "bundled gems"), but
# Rails 6.1.7.x (activesupport) still requires them. Declare them explicitly so
# the bundle resolves on Ruby >= 3.4. See #11 (3.3 -> 3.4 bump).
gem 'bigdecimal'
gem 'mutex_m'
gem 'drb'
gem 'base64'
gem 'logger'

# opal-rails pulls sprockets-rails in; the opal-sprockets route (the only one
# Rails 8 can take -- see supported_versions.yml) does not, and Rails 7+ no
# longer ships it with the framework. The test_app serves the Opal bundle
# through sprockets, so declare it. (#20)
gem 'sprockets-rails'
